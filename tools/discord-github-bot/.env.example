# Discord Developer Portal bot token
DISCORD_TOKEN=
# IDs from Discord Developer Mode
DISCORD_GUILD_ID=
DISCORD_FORUM_CHANNEL_ID=
# Comma-separated Discord role IDs allowed to approve/reject
DISCORD_MODERATOR_ROLE_IDS=
# GitHub repository and a fine-grained PAT with Issues read/write on this repo
GITHUB_REPOSITORY=F0xyN0xy/KitaWatch
GITHUB_TOKEN=
# Set a long random secret in both this service and the GitHub webhook configuration
GITHUB_WEBHOOK_SECRET=
# WispByte's assigned port is often supplied as PORT; do not hard-code it
PORT=3000
# Use an absolute path on persistent storage if WispByte provides one
DATABASE_PATH=./data/feedback.sqlite
# Optional forum tag IDs; leave blank to skip automatic tag changes
DISCORD_PENDING_TAG_ID=
DISCORD_APPROVED_TAG_ID=
DISCORD_REJECTED_TAG_ID=
DISCORD_RESOLVED_TAG_ID=