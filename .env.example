# KitaWatch environment configuration
ANILIST_CLIENT_ID=34664
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=https://kitawatch.free.nf/?oauth_callback=anilist

# Supabase — shared KitaWatch backend
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Public hCaptcha sitekey (safe to include in the desktop app build).
# The matching secret belongs only in Supabase Auth CAPTCHA settings.
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_sitekey_here

# Optional TMDB-backed anime metadata API base URL (must include scheme and host)
VITE_ANIME_METADATA_API_URL=
