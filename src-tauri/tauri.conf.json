{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KitaWatch",
  "version": "0.8.1",
  "identifier": "com.kitawatch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KitaWatch",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.anilist.co https://i.anilist.co https://s4.anilist.co http://localhost:* http://127.0.0.1:*; media-src 'self' blob: http://localhost:* http://127.0.0.1:* https:; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* wss://localhost:* https://graphql.anilist.co https://*.anilist.co https://api.aniskip.com wss://api.aniskip.com https://nyaa.si https://*.nyaa.si; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/kitawatch-kuhi-api",
      "binaries/kitawatch-proxy",
      "binaries/kitawatch-anivexa"
    ],
    "resources": [
      ".env.example"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0t64 | libgtk-3-0",
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kitawatch"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzODVEMzgyMDRGNkI4NTMKUldSVHVQWUVndE9Gd3ltaVFIN0IySEtWZ2JpOXZsTkJwVlJZbzYrYWU4cWxjd3Q4U3VrYytIdXQK",
      "endpoints": [
        "https://github.com/F0xyN0xy/KitaWatch/releases/latest/download/latest.json"
      ]
    }
  }
}
