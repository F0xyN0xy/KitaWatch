{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "shell:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    "updater:default"
  ]
}
