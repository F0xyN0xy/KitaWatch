{
  "name": "kitawatch",
  "private": true,
  "version": "4.0.0",
  "description": "KitaWatch - desktop anime streaming client (Tauri v2 + React)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "setup:api": "node scripts/setup-api.mjs",
    "api": "node scripts/run-api.mjs",
    "sidecar:preview": "npm run build:sidecars && tauri dev",
    "setup:anivexa": "node scripts/setup-anivexa.mjs",
    "build:sidecars": "node scripts/build-sidecars.mjs",
    "release:tag": "node scripts/tag-release.mjs",
    "release": "npm run build:sidecars && tauri build",
    "test": "node --test \"tests/**/*.test.*\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "artplayer": "^5.4.0",
    "framer-motion": "^14.7.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
